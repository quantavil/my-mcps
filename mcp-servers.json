{
  "$schema": "https://json.schemastore.org/mcp-servers.json",
  "servers": {
    "filesystem": {
      "command": "bunx",
      "args": [
        "@modelcontextprotocol/server-filesystem",
        "${HOME}/Documents"
      ],
      "description": "Local filesystem access for documents and projects"
    },
    "fetch": {
      "command": "uvx",
      "args": [
        "mcp-server-fetch"
      ],
      "description": "Web page and URL content fetcher"
    },
    "memory": {
      "command": "bunx",
      "args": [
        "@modelcontextprotocol/server-memory"
      ],
      "description": "Knowledge graph persistent memory server"
    },
    "github": {
      "command": "bunx",
      "args": [
        "@modelcontextprotocol/server-github"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_PERSONAL_ACCESS_TOKEN}"
      },
      "description": "GitHub repos, issues, and PR management"
    },
    "firecrawl": {
      "command": "bunx",
      "args": [
        "firecrawl-mcp"
      ],
      "env": {
        "FIRECRAWL_API_KEY": "${FIRECRAWL_API_KEY}"
      },
      "description": "Web scraping, search, and markdown extraction via Firecrawl"
    },
    "context7": {
      "command": "bunx",
      "args": [
        "@upstash/context7-mcp"
      ],
      "env": {
        "CONTEXT7_API_KEY": "${CONTEXT7_API_KEY}"
      },
      "description": "Up-to-date documentation and code examples via Context7"
    },
    "codebase-memory": {
      "command": "bunx",
      "args": [
        "codebase-memory-mcp"
      ],
      "description": "Codebase memory knowledge graph and AST analysis"
    },
    "dart": {
      "command": "dart",
      "args": [
        "mcp-server"
      ],
      "description": "Official Dart and Flutter development MCP server"
    },
    "blender": {
      "command": "uvx",
      "args": [
        "mcp-for-blender"
      ],
      "description": "Blender 3D scene creation, manipulation, and modeling MCP server",
      "enabled": false
    }
  }
}
